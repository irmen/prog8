%import audio
%import exec
%import textio

; TODO making high level audio interface for amiga


main {
    const uword SAMPLE_RATE = 8000  ; Hz
    const uword SAMPLE_COUNT = len(sample.data)

    sub start() {
        txt.print("HL Audio test\n")

        ; 3. Open device passing array directly (no &&)
        txt.print("init audio...\n")
        if audio_hl.init() {

            txt.print("\nplay 4 L...")
            audio.AudioIO.Unit = 8  ; channel 4
            audio_hl.play(sample.data, SAMPLE_COUNT, SAMPLE_RATE, 64, 1)
            txt.print("wait till end ")
            audio_hl.wait()

            txt.print("\nplay 3 R...")
            audio.AudioIO.Unit = 4  ; channel 3
            audio_hl.play(sample.data, SAMPLE_COUNT, SAMPLE_RATE, 64, 2)
            txt.print("wait till end ")
            audio_hl.wait()

            txt.print("\nplay 1 L...")
            audio.AudioIO.Unit = 1  ; channel 1
            audio_hl.play(sample.data, SAMPLE_COUNT, SAMPLE_RATE, 64, 1)
            txt.print("wait till end ")
            audio_hl.wait()

            txt.print("\nplay 2 R...")
            audio.AudioIO.Unit = 2  ; channel 2
            audio_hl.play(sample.data, SAMPLE_COUNT, SAMPLE_RATE, 64, 2)
            txt.print("wait till end ")
            audio_hl.wait()

            txt.print("\nClosing down.\n")

            audio.AudioIO.Unit = 15  ; all channels
            audio_hl.closedown()
        }
    }
}

audio_hl {
    ; attempt to make a high level audio module

    sub init() -> bool {
        ubyte[1] channel_matrix = [15]      ; allocate all 4 channels
        return audio.opendevice(channel_matrix, 1, 0)
    }

    sub closedown() {
        audio.closedevice()
    }

    sub play(^^byte samples, long num_samples, uword sample_rate, ubyte volume, uword cycles) {
        audio.AudioIO.Command = exec.CMD_WRITE
        audio.AudioIO.Flags = audio.ADIOF_PERVOL
        audio.AudioIO.Data = samples
        audio.AudioIO.IOAudio_Length = num_samples
        audio.AudioIO.Period = audio.period(sample_rate)
        audio.AudioIO.Volume = volume
        audio.AudioIO.Cycles = cycles
        ; not exec.DoIO/SendIO: those clear io_Flags, wiping ADIOF_PERVOL!
        audio.BeginIO(audio.AudioIO)
    }

    sub wait() {
        void exec.WaitIO(audio.AudioIO)
    }
}


