; text - bare-metal 8x8 text renderer for the Amiga (CPU-only, no OS calls).
; Shared by amiga500 and amiga1200 targets.
;
; Rendering is limited to the embedded 8x8 font (font8x8_basic, 128 glyphs).
; Custom fonts, variable-size glyphs, and font switching are NOT supported.
; Reverse video is available via bit 7 of the character byte (no second font).

%import math
%import strings

text {
    %option merge, no_symbol_prefixing, ignore_unused

    private uword @shared pitch
    private ubyte @shared depth
    private pointer[8] @shared planes

    sub init(uword p, ubyte d, ^^pointer bitplanes) {
        pitch = p
        if d > 8 { d = 8 }
        depth = d
        ubyte i = 0
        while i < d {
            planes[i] = bitplanes[i]
            i = i + 1
        }
    }

    sub char(uword x, uword y, ubyte chr, ubyte color) {
        uword plane_mask = color & ((1 << depth) - 1)
        long row_offset = math.mul32(y, pitch)
        draw_glyph(x, row_offset, chr, plane_mask)
    }

    sub print(uword x, uword y, str message, ubyte color) {
        uword plane_mask = color & ((1 << depth) - 1)
        long row_offset = math.mul32(y, pitch)
        uword cx = x
        ubyte i = 0
        while i < strings.length(message) {
            ubyte chr = message[i]
            if chr == 10 {
                cx = x
                y = y + 8
                row_offset = math.mul32(y, pitch)
                i = i + 1
                continue
            }
            draw_glyph(cx, row_offset, chr, plane_mask)
            cx = cx + 8
            i = i + 1
        }
    }


    private asmsub draw_glyph(uword x @D0, long rowOffset @D1, ubyte chr @D2, uword mask @D3) {
        %asm {{
            movem.l d2-d7/a2-a4,-(sp)
            ; d7 = shift in low byte, reverse flag in bit 8
            move.w  d0,d7
            andi.w  #7,d7
            tst.b   d2
            bpl     .notrev
            ori.w   #$100,d7
.notrev:
            move.w  d0,d5
            lsr.w   #3,d5
            ; a1 = rowBase = rowOffset + byteCol
            move.l  d1,a1
            ext.l   d5
            add.l   d5,a1
            ; a2 = pitch (long)
            moveq   #0,d0
            move.w  text.pitch,d0
            move.l  d0,a2
            ; a3 = font8x8 + (chr & $7f) * 8
            moveq   #0,d0
            move.b  d2,d0
            andi.w  #$7f,d0
            lsl.w   #3,d0
            lea     text.font8x8,a3
            add.l   d0,a3
            lea     text.planes,a4
            ; d6 = depth
            moveq   #0,d6
            move.b  text.depth,d6
            moveq   #0,d5           ; row index
.rowloop:
            cmpi.w  #8,d5
            bge     .done
            move.b  (a3,d5.w),d2    ; glyph row
            btst    #8,d7
            beq     .norev
            not.b   d2              ; reverse video
.norev:
            tst.b   d2
            beq     .nextrow        ; empty row
            tst.b   d7
            bne     .shifted
            ; unshifted: single coverage byte in d2
            moveq   #0,d0           ; plane index
.planloop0:
            cmp.l   d6,d0
            bge     .nextrow
            move.l  d0,d1
            lsl.l   #2,d1
            move.l  (a4,d1.w),a0
            add.l   a1,a0
            btst    d0,d3
            beq     .clear0
            or.b    d2,(a0)
            bra     .plancont0
.clear0:
            move.b  d2,d1
            not.b   d1
            and.b   d1,(a0)
.plancont0:
            addq.l  #1,d0
            bra     .planloop0
.shifted:
            ; d0 = left = g >> shift, d2 = right = g << (8-shift)
            move.b  d7,d4
            move.b  d2,d0
            lsr.b   d4,d0
            moveq   #8,d1
            sub.b   d4,d1
            lsl.b   d1,d2
            moveq   #0,d1           ; plane index
.planloops:
            cmp.l   d6,d1
            bge     .nextrow
            move.l  d1,d4           ; shift no longer needed
            lsl.l   #2,d4
            move.l  (a4,d4.w),a0
            add.l   a1,a0
            btst    d1,d3
            beq     .clears
            or.b    d0,(a0)
            or.b    d2,1(a0)
            bra     .planconts
.clears:
            move.b  d0,d4
            not.b   d4
            and.b   d4,(a0)
            move.b  d2,d4
            not.b   d4
            and.b   d4,1(a0)
.planconts:
            addq.l  #1,d1
            bra     .planloops
.nextrow:
            add.l   a2,a1
            addq.w  #1,d5
            bra     .rowloop
.done:
            movem.l (sp)+,d2-d7/a2-a4
            rts
        }}
    }

    private sub draw_glyph_prog8_working(uword x, long rowOffset, ubyte chr, uword mask) {
        ubyte shift = lsb(x) & 7
        uword byteCol = x >> 3
        long rowBase = rowOffset + byteCol
        uword glyphIndex = (chr as uword & $7F) * 8
        bool reverse = (chr & $80) != 0
        ubyte row
        for row in 0 to 7 {
            ubyte g = font8x8[glyphIndex + row]
            if reverse { g = ~g }
            if g == 0 {
                rowBase += pitch
                continue
            }
            ubyte p
            for p in 0 to depth-1 {
                pointer addr = planes[p] + rowBase
                uword bit = 1 << p
                if shift == 0 {
                    if (mask & bit) != 0 {
                        @(addr) |= g
                    } else {
                        @(addr) &= ~g
                    }
                } else {
                    ubyte left = g >> shift
                    ubyte right = g << (8 - shift)
                    if (mask & bit) != 0 {
                        @(addr) |= left
                        @(addr+1) |= right
                    } else {
                        @(addr) &= ~left
                        @(addr+1) &= ~right
                    }
                }
            }
            rowBase += pitch
        }
    }

